{
  "schema_version": 1,
  "as_of": "2026-10-31",
  "sources": [
    "https://learn.chatgpt.com/docs/pricing#token-rates",
    "https://learn.chatgpt.com/docs/agent-configuration/speed#fast-mode"
  ],
  "basis": "included_subscription_estimate",
  "unit": "USD",
  "usd_equivalent": {
    "credits_per_usd": 25,
